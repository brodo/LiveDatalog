% Fifty famous researchers.
%
% researcher(Id, Name).
% field(Id, Field).               -- one fact per field
% born(Id, Year).  died(Id, Year).  -- years BCE are negative
% born_in(Id, City, Country).     -- the country the city belongs to today

researcher(archimedes, "Archimedes").
field(archimedes, mathematics). field(archimedes, physics).
born(archimedes, -287). died(archimedes, -212).
born_in(archimedes, "Syracuse", italy).

